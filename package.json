{
  "name": "webrobot-pipeline-studio",
  "version": "0.1.0",
  "description": "Host-agnostic client + React UI for the WebRobot Tenant Studio pipeline designer (org-scoped /tenant API).",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/react": "^18"
  },
  "keywords": [
    "webrobot",
    "etl",
    "pipeline",
    "scraping",
    "designer",
    "spark"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WebRobot-Ltd/webrobot-pipeline-studio.git"
  },
  "sideEffects": false
}